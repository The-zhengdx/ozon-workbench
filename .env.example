# 复制为 .env。后端启动时会自动读取，已存在的环境变量不会被覆盖。

# PostgreSQL 16+。库可以是空的，程序会执行 migrations/0001、0002 和 0003。
DATABASE_URL=postgres://ozon:ozon@127.0.0.1:5432/ozon_workbench?sslmode=disable

HTTP_ADDR=0.0.0.0:18081
WORK_ROOT=data/work
MIGRATIONS_DIR=migrations

# true：不访问 api-seller.ozon.ru。false：使用下面的地址和店铺里的 Client-Id / Api-Key。
OZON_MOCK=true
OZON_API_BASE=https://api-seller.ozon.ru

# Codex CLI。Windows 上可以写成 codex.cmd，程序会通过 cmd.exe 启动。
CODEX_BIN=codex

# 对象存储在「系统设置」页面填写，明文存在数据库。默认不配置，不读取 OSS_* 环境变量。

# 可选。设置后会再跑一遍真实库迁移测试。
# OZON_TEST_DATABASE_URL=postgres://ozon:ozon@127.0.0.1:5432/ozon_workbench_test?sslmode=disable
