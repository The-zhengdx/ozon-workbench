# 本地开发示例。复制为 .env 后可按需修改。
# 这不是生产密钥：任意口令都会经 SHA-256 派生为 AES-256 密钥。
# 也可以直接提供 64 位十六进制，或 32 字节的标准 Base64。
OZON_CREDENTIAL_KEY=dev-only-local-key-change-me-please

# 本地 PostgreSQL（与 docker-compose / 本机安装一致）
DATABASE_URL=postgres://ozon:ozon@127.0.0.1:5432/ozon_workbench?sslmode=disable

# 后端监听地址
HTTP_ADDR=0.0.0.0:18081

# true：不访问 api-seller.ozon.ru，使用内置模拟响应（请求形状与正式接口一致）
# false：使用下方地址发起真实调用
# 这个文件不会被进程自动读取。启动前要 export，或由 shell 导入。
# config.yaml 的 ozon.mock 以及 docker compose 未设置时的默认值都是 true。
OZON_MOCK=true
OZON_API_BASE=https://api-seller.ozon.ru

# 访问 Ozon 的代理。direct（或留空）= 直连并忽略 HTTP_PROXY/HTTPS_PROXY/ALL_PROXY。
# env = 跟随那些变量。也可以写成 http://127.0.0.1:7890 或 socks5://127.0.0.1:7891。
# OZON_PROXY=direct

# 单个 Client-Id 的请求速率上限（次/秒）。Ozon 文档的总量级上限约为 50。
OZON_RATE_LIMIT=10

# 素材包解压目录。上传的 zip 在解压结束后会被删除。
MEDIA_ROOT=data/media

# true：不调用本机 Codex CLI，用内置模拟运行器走完整状态机（开发和 CI 的默认值）
# false：按 configs/config.yaml 里的命令模板执行 codex exec / codex exec resume
CODEX_MOCK=true
CODEX_BIN=codex
